{
  "expo": {
    "name": "LMS",
    "slug": "LMS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coirei-cirlce-logo.png",
    "scheme": "lms",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/coirei-cirlce-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/coirei-cirlce-logo.png",
       
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/coirei-cirlce-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}